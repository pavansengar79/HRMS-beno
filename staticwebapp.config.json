{
  "trailingSlash": "auto",
  "navigationFallback": {
    "rewrite": "/404.html",
    "exclude": ["/_next/*", "/images/*", "/locales/*", "/*.{png,jpg,jpeg,gif,svg,ico,webp,css,js,json,txt,xml,map,woff,woff2,ttf,html}"]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html"
    }
  },
  "routes": [
    {
      "route": "/_next/static/*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    }
  ]
}