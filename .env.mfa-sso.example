# ─── MFA (Multi-Factor Authentication) Configuration ────────────────────────

# Generate a 32-byte key for encrypting MFA secrets
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=your_32_byte_key_in_hex_here

# ─── WorkOS SSO Configuration ───────────────────────────────────────────────

# Get these from: https://dashboard.workos.com/api-keys
WORKOS_API_KEY=sk_test_your_workos_api_key
WORKOS_CLIENT_ID=client_your_workos_client_id

# Your SSO callback URL (must match what's configured in WorkOS dashboard)
WORKOS_REDIRECT_URI=https://your-backend-url.com/api/v1/auth/sso/callback

# Frontend URL for redirecting after SSO login
FRONTEND_URL=https://your-frontend-url.com

# Backend URL (for constructing OAuth URLs)
BACKEND_URL=https://your-backend-url.com

# Default role for SSO-provisioned users (must match a Role.slug in your DB)
SSO_DEFAULT_ROLE=employee

# App name shown in authenticator apps
APP_NAME=BenoSupport HRMS

# ─── Security Notes ────────────────────────────────────────────────────────

# 1. NEVER commit these values to git
# 2. Keep MFA_ENCRYPTION_KEY secure - if compromised, all MFA secrets are exposed
# 3. Use different WorkOS credentials for dev/staging/production
# 4. Configure redirect URIs in WorkOS dashboard for each environment
