# Browser-facing backend origin; do not append /api/v1 or a trailing slash.
# Some views default to localhost:4000; auth views also contain localhost:5000 fallbacks.
# Set this explicitly in every environment, including the build environment for static export.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Cloudinary cloud name used by attendance regularization uploads.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Legacy mock auth only (src/@test-db/auth/jwt.js):
# NEXT_PUBLIC_JWT_SECRET, NEXT_PUBLIC_JWT_EXPIRATION, NEXT_PUBLIC_JWT_REFRESH_TOKEN_SECRET
# Do not configure these for production: NEXT_PUBLIC_ values are exposed to browsers.